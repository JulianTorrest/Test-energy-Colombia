# Copia este archivo a .env y ajusta los valores.
# Recorda: .env NO debe quedar versionado con secretos reales.
# `make up` lo genera automaticamente con valores aleatorios si no existe.
PG_HOST=127.0.0.1
PG_PORT=5432
PG_DATABASE=bia_datos
PG_SUPERUSER=postgres
PG_SUPERPASSWORD=REEMPLAZAR

# Credenciales efimeras SOLO para evaluacion local.
PG_ROL_INGESTA_USER=rol_ingesta
PG_ROL_INGESTA_PASSWORD=REEMPLAZAR
PG_ROL_ANALISTA_USER=rol_analista
PG_ROL_ANALISTA_PASSWORD=REEMPLAZAR
PG_ROL_AUDITOR_USER=rol_auditor
PG_ROL_AUDITOR_PASSWORD=REEMPLAZAR

# Llave AES-256-GCM para cifrar PII en reposo (hex, 64 chars = 32 bytes).
PII_ENCRYPTION_KEY=REEMPLAZAR

MINIO_ENDPOINT=http://localhost:9000
MINIO_ACCESS_KEY=REEMPLAZAR
MINIO_SECRET_KEY=REEMPLAZAR

KAFKA_BOOTSTRAP=localhost:9092
KAFKA_TOPIC=mediciones.raw
